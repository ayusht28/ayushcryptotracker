# services/price-service/.env.example
# Copy this file to .env and fill in real values for local dev.
# Never commit .env to version control.

PORT=3002
POLL_INTERVAL_MS=60000

# Optional — only needed if you have a CoinGecko Pro API key
COINGECKO_API_KEY=

# Comma-separated CoinGecko coin IDs to track
COIN_IDS=bitcoin,ethereum,binancecoin,solana,cardano,ripple,dogecoin,polkadot,litecoin,chainlink,avalanche-2,matic-network
