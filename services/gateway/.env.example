# services/gateway/.env.example

PORT=3001
NODE_ENV=development

# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis URL — use rediss:// (TLS) in production (required)
REDIS_URL=rediss://default:token@host:6379

# URL of the Price Service (required)
PRICE_SERVICE_URL=http://localhost:3002

# How often the Gateway polls the Price Service (ms)
PRICE_POLL_INTERVAL_MS=60000

# Comma-separated allowed CORS origins (required in production)
CORS_ORIGIN=http://localhost:5173

# WebSocket keep-alive ping interval (ms)
WS_PING_INTERVAL_MS=30000
